# ─── Конфиденциальные данные заказчика ────────────────────────────────────
# Главная опасность этого проекта: случайно закоммитить реальный договор
# с живыми ИНН, счетами и паспортами. Каталоги для реальных документов
# игнорируются целиком; в репозиторий попадает только синтетика с разметкой
# из fixtures/labeled/.
fixtures/real/
fixtures/incoming/
/data/
!fixtures/labeled/
!fixtures/labeled/**

# ─── Секреты ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.credentials.yaml
credentials.yaml
secrets.yaml
gigachat_*.key
*.pem

# ─── Результаты работы пайплайна ──────────────────────────────────────────
# Обезличенные документы и отчёты воспроизводятся из fixtures командой make demo.
/out/
/output/
spikes/out/
*.masked.docx
*.masked.xlsx
*.masked.pdf

# ─── Состояние графа и сессий ─────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
/checkpoints/
.langgraph_api/

# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
*.egg-info/
.eggs/
wheels/

# ─── Виртуальные окружения ────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Кеши инструментов ────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.tox/
.nox/

# ─── Модели и кеши распознавания ──────────────────────────────────────────
# Веса Natasha и промежуточные изображения OCR: большие, скачиваются заново.
/models/
*.tar
*.navec
*.slovnet
.ocr_cache/

# ─── Агентная обвязка ─────────────────────────────────────────────────────
# .claude/settings.json и .dsh/skills/ — часть проекта, они коммитятся.
# Игнорируется только локальное состояние конкретной машины.
.claude/settings.local.json
.claude/state/
.dsh/sessions/
.dsh/storages/
.dsh/cache/
.agents/cache/

# ─── Среда разработки ─────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Прочий мусор ─────────────────────────────────────────────────────────
*.log
~$*.docx
~$*.xlsx
