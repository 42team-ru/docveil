# Postgres
POSTGRES_USER=masker
POSTGRES_PASSWORD=masker
POSTGRES_DB=masker

# Строка подключения приложения (asyncpg-драйвер)
DATABASE_URL=postgresql+asyncpg://masker:masker@localhost:5432/masker

# MinIO (для docker-compose — поднимает сервер)
MINIO_ROOT_USER=masker
MINIO_ROOT_PASSWORD=masker123

# MinIO (для клиента приложения)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=masker
MINIO_SECRET_KEY=masker123
MINIO_SECURE=false
MINIO_BUCKET=documents

# API
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# false для локальной разработки по http (без TLS)
COOKIE_SECURE=true

# make seed-admin (можно не задавать и передать --email/--password явно)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
# ADMIN_FULL_NAME=Admin
