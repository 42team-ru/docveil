# ==============================================================================
# Единый список переменных окружения проекта triema-masker.
#
# Скопируйте файл в `.env` (см. `.gitignore` — `.env` в git не попадает) и
# заполните значения под свою среду. Здесь собраны переменные ОБОИХ слоёв:
#
#   - веб-слой (FastAPI + Postgres + MinIO) — читает `src/api/core/config.py:
#     Settings` (pydantic-settings, тот же файл `.env`);
#   - движок обезличивания (`masker`, CLI) — читает переменные напрямую из
#     `os.environ` в местах использования (`src/masker/llm`, `src/masker/ocr`,
#     `src/masker/detect/gliner.py`). Это осознанное решение: `masker` обязан
#     работать без БД/MinIO/API (`.venv/bin/masker --help` работает и без
#     `.env`), поэтому он не зависит от `Settings` веб-слоя.
#
# Каждая переменная ниже отмечена как «обязательна» или «необязательна».
# «Обязательна» значит: без неё соответствующий компонент не запустится
# (упадёт на старте, а не тихо съест дефолт).
# ==============================================================================

# ---------- Postgres (сервер в контейнере docker-compose) -------------------
# Логин/пароль/имя БД для контейнера Postgres из docker-compose.yml.
# Необязательны при локальном запуске без `docker compose up` (сервер уже
# существует и слушает `DATABASE_URL` ниже).
POSTGRES_USER=masker
POSTGRES_PASSWORD=masker
POSTGRES_DB=masker

# ---------- API / веб-слой (src/api/core/config.py:Settings) ----------------
# Строка подключения к БД, asyncpg-драйвер. ОБЯЗАТЕЛЬНА для веб-слоя
# (`make api`, `make migrate`, `make seed-admin`); движку `masker` не нужна.
DATABASE_URL=postgresql+asyncpg://masker:masker@localhost:5432/masker

# Секрет подписи JWT-токенов. ОБЯЗАТЕЛЕН, дефолта нет — без него `Settings()`
# упадёт при импорте API. Сгенерировать случайный: `openssl rand -hex 32`.
JWT_SECRET=change-me

# Алгоритм подписи JWT. Необязательна, по умолчанию HS256.
JWT_ALGORITHM=HS256

# Срок жизни access-токена, минуты. Необязательна, по умолчанию 15.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Срок жизни refresh-токена, дни. Необязательна, по умолчанию 30.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Флаг Secure у cookie с refresh-токеном (требует HTTPS, если true).
# Необязательна, по умолчанию true; для локальной разработки по http — false.
COOKIE_SECURE=true

# Порт, на котором uvicorn поднимает FastAPI (`make api`, `Dockerfile` CMD,
# `docker-compose.yml`). Необязательна, по умолчанию 8000.
APP_PORT=8000

# ---------- MinIO (хранилище файлов) -----------------------------------------
# Логин/пароль сервера MinIO в контейнере docker-compose. Необязательны при
# запуске без `docker compose up`.
MINIO_ROOT_USER=masker
MINIO_ROOT_PASSWORD=masker123

# Адрес MinIO, ключ доступа, секретный ключ — клиент приложения. ОБЯЗАТЕЛЬНЫ,
# дефолтов нет (см. `src/api/core/storage.py`).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=masker
MINIO_SECRET_KEY=masker123

# TLS при обращении к MinIO. Необязательна, по умолчанию false (локальный
# сервер без TLS).
MINIO_SECURE=false

# Бакет для хранения документов. Необязательна, по умолчанию documents.
MINIO_BUCKET=documents

# ---------- Создание первого администратора (make seed-admin) ---------------
# Необязательны: без них `make seed-admin` потребует `--email`/`--password`
# аргументами командной строки вместо переменных.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
# ADMIN_FULL_NAME=Admin

# ==============================================================================
# Движок обезличивания (masker): CLI и графовый конвейер. Работает без БД,
# MinIO и API — переменные ниже читает сам masker-код напрямую из окружения.
# ==============================================================================

# ---------- LLM-провайдер (роли сторон, судья, свои типы, карточка договора) -
# Какой LLMProvider использовать (`masker.llm.get_provider`). Необязательна,
# по умолчанию fake — детерминированные ответы без сети, используется в
# тестах и в CLI, если не задано иное. Варианты: fake | cassette | openrouter
# | gigachat.
MASKER_LLM=fake

# Название модели у выбранного провайдера. ОБЯЗАТЕЛЬНА для openrouter и
# gigachat, если модель не передана через `--llm-config`; для fake/cassette
# не используется.
# MASKER_LLM_MODEL=GigaChat

# Каталог с записанными ответами для MASKER_LLM=cassette (детерминированные
# тесты без сети). Необязательна, по умолчанию `fixtures/llm/roles`.
# MASKER_LLM_CASSETTE_DIR=fixtures/llm/roles

# --- OpenRouter ---
# Ключ авторизации OpenRouter. ОБЯЗАТЕЛЕН только при MASKER_LLM=openrouter.
# Секрет — не публиковать, не коммитить.
# OPENROUTER_API_KEY=

# --- GigaChat (Сбер) ---
# Ключ авторизации GigaChat (Authorization Key из личного кабинета).
# ОБЯЗАТЕЛЕН только при MASKER_LLM=gigachat. Секрет — не публиковать,
# не коммитить.
# GIGACHAT_CREDENTIALS=

# Область токена GigaChat. Необязательна, по умолчанию GIGACHAT_API_PERS
# (физлица/пробный доступ); для юрлиц — GIGACHAT_API_CORP или
# GIGACHAT_API_B2B, см. личный кабинет GigaChat.
# MASKER_LLM_GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Путь к доверенному корневому сертификату (например, сертификату Минцифры
# России), если он у вас уже есть, а системное хранилище доверенных
# сертификатов его не содержит. Без него запрос к GigaChat может падать с
# `SSL: CERTIFICATE_VERIFY_FAILED: self-signed certificate in certificate
# chain`. Необязательна, по умолчанию не задана (используется системное
# хранилище доверенных сертификатов). Проект НЕ скачивает и не хранит такой
# сертификат сам — переменная должна указывать на уже имеющийся у вас файл
# `.pem`/`.cer`.
# MASKER_LLM_GIGACHAT_CA_BUNDLE=/path/to/your/trusted_root_ca.cer

# Полностью отключить проверку TLS-сертификата GigaChat. Небезопасно, поэтому
# по умолчанию проверка ВСЕГДА включена и отключается только этим явным
# флагом (1/true/yes). Предпочтительный способ решить проблему с сертификатом
# Минцифры — переменная выше (MASKER_LLM_GIGACHAT_CA_BUNDLE), а не эта.
# MASKER_LLM_GIGACHAT_INSECURE_SKIP_TLS_VERIFY=

# ---------- OCR для сканированных PDF ----------------------------------------
# Какой OCR-провайдер обрабатывает сканы (`masker.ocr.select.select_ocr`).
# Необязательна, по умолчанию fake — детерминированная заглушка для тестов и
# CI, без сети и без весов моделей. Варианты: fake | paddle | paddle_vl |
# rapid | tesseract. Неизвестное значение — явная ошибка, а не тихий откат.
MASKER_OCR=fake

# Отключить автоопределение ориентации страницы в PaddleOCR (диагностика).
# Необязательна, по умолчанию автоопределение включено (переменная не
# установлена). Значения 1/true/yes отключают его.
# PADDLE_NO_ORI_CLASSIFY=

# ---------- GLiNER2 (опциональный локальный детектор своих типов) ------------
# Путь к каталогу с локальными весами GLiNER2. Необязательна, по умолчанию
# `models/gliner`. Нужна только для пользовательских типов на базе gliner_*
# (требует extra `gliner`, см. `docs/SETUP.md`).
# MASKER_GLINER_PATH=models/gliner

# ---------- Служебные переменные (обычно задавать вручную не нужно) ---------
# Параллелизм pytest. Необязательна. У `make test` дефолт 4 (параллельно),
# у `make gate`/`scripts/gate.sh` дефолт 0 (последовательно — так надёжнее
# для тестов, поднимающих вложенные процессы).
# PYTEST_WORKERS=0

# HF_HUB_OFFLINE и TRANSFORMERS_OFFLINE выставляет сам `scripts/gate.sh`
# перед прогоном ворот (чтобы `make gate` не тянул сеть за моделями Hugging
# Face) — задавать их в `.env` самостоятельно не требуется.
