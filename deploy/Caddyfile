# Публичный вход стенда: TLS, один домен, два апстрима.
#
# Почему Caddy, а не nginx с certbot: сертификат Let's Encrypt выпускается и
# продлевается сам, без крона и без отдельного шага в скрипте развёртывания.
# Для стенда, который по условию соревнования обязан прожить десять рабочих
# дней после защиты, это ровно та разница, из-за которой стенды и падают.
#
# SITE_ADDRESS задаётся в .env:
#   docveil.example.ru  — домен, тогда TLS выпускается автоматически;
#   :80                 — без домена и без TLS (локальная проверка, IP-адрес).

{
	email {$ACME_EMAIL:admin@localhost}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Загружаются сканы и многостраничные PDF, поэтому лимит щедрый, но он
	# есть: без него один запрос может занять диск стенда целиком.
	request_body {
		max_size 200MB
	}

	# Префикс `/api` НЕ срезается: маршруты FastAPI объявлены вместе с ним
	# (`api_router = APIRouter(prefix="/api")`), и `handle_path` здесь сломал
	# бы каждый вызов. Именно поэтому directive — `handle`, а не `handle_path`.
	handle /api/* {
		reverse_proxy backend:8000 {
			# Прогон большого скана считается десятками секунд, а отчёт
			# отдаётся одним ответом: дефолтных таймаутов Caddy хватает,
			# но заголовки исходного хоста нужны для правильных ссылок.
			header_up X-Real-IP {remote_host}
		}
	}

	# Swagger и схема — тем же путём, что и API: удобно показывать на защите.
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}

	# ES-модули: принудительно правильный тип. nginx внутри образа фронта не
	# знает расширение `.mjs` и отдаёт воркер pdf.js как
	# `application/octet-stream`; браузер по спецификации такой модуль не
	# исполняет, и просмотрщик молча откатывается на «fake worker».
	#
	# Сам образ уже исправлен (frontend/nginx.conf), но стенд тянет готовый
	# образ из GHCR, и правка доедет только со следующим релизом. Эта строка
	# чинит стенд сразу и остаётся безвредной после релиза: она выставляет
	# тот же тип, который к тому времени придёт снизу.
	@mjs path *.mjs
	handle @mjs {
		reverse_proxy frontend:80 {
			header_down Content-Type text/javascript
		}
	}

	# Всё остальное — статика React Router, собранная в образ frontend.
	handle {
		reverse_proxy frontend:80
	}

	log {
		output stdout
		format console
	}
}
