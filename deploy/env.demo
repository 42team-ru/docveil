# Готовое окружение для демонстрационного стенда: развернуть и показывать.
#
#   ./scripts/deploy.sh up --demo
#
# Скрипт копирует этот файл в `.env.prod` и не задаёт ни одного вопроса.
# Пароли здесь ФИКСИРОВАННЫЕ и лежат в открытом репозитории — это осознанный
# размен: демонстрационный стенд должен подниматься без переписки о том, кто
# кому передал пароль, а учётные данные всё равно напечатаны в README.
#
# ЧТО ЭТО ЗНАЧИТ НА ПРАКТИКЕ. Стенд, поднятый этим файлом, обязан считаться
# публичным: любой, кто видел репозиторий, знает от него пароли и может
# войти. Настоящие тендерные документы сюда не загружаются — ни свои, ни
# заказчика. Для стенда, который переживёт защиту и будет доступен десять
# рабочих дней, генерируйте секреты: `./scripts/deploy.sh up` без --demo.

# Без домена: http на IP машины, TLS не выпускается.
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
ACME_EMAIL=admin@localhost
# Обязательно false: по http браузер не отдаёт Secure-cookie, и сессия
# разваливается на первой же перезагрузке вкладки.
COOKIE_SECURE=false

POSTGRES_USER=masker
POSTGRES_PASSWORD=demo-postgres-password
POSTGRES_DB=masker
JWT_SECRET=demo-jwt-secret-not-for-production-use
MINIO_ROOT_USER=masker
MINIO_ROOT_PASSWORD=demo-minio-password
MINIO_BUCKET=documents

# Учётные записи стенда. Те же значения напечатаны в README.
ADMIN_EMAIL=admin@docveil.local
ADMIN_PASSWORD=docveil-admin
ADMIN_FULL_NAME=Администратор стенда
# Второй аккаунт без прав администратора — чтобы показывать продукт, не
# отдавая управление пользователями.
DEMO_USER_EMAIL=demo@docveil.local
DEMO_USER_PASSWORD=docveil-demo
DEMO_USER_FULL_NAME=Демонстрационный пользователь

MASKER_OCR=tesseract
# Без ключа модель не зовётся вовсе: роли сторон считает эвристика, продукт
# работает целиком. Ключ дописывается сюда же и MASKER_LLM=gigachat.
MASKER_LLM=fake
GIGACHAT_CREDENTIALS=
MASKER_LLM_GIGACHAT_SCOPE=GIGACHAT_API_PERS
MASKER_LLM_GIGACHAT_CA_BUNDLE=
OPENROUTER_API_KEY=

BACKEND_MEMORY_LIMIT=3g
BACKEND_CPU_LIMIT=4
POSTGRES_MEMORY_LIMIT=1g
MINIO_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=256m
CADDY_MEMORY_LIMIT=256m
