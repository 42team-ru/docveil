# Шаблон окружения стенда. Рабочий файл — `.env.prod` в корне репозитория;
# он попадает под `.env.*` в .gitignore и в git не уезжает.
#
# Заполнять руками не обязательно: `./scripts/deploy.sh` создаёт `.env.prod`
# сам, генерируя секреты через `openssl rand`. Этот файл — карта полей и
# способ развернуть стенд неинтерактивно (CI, чужой сервер).

# ---------- Публичный адрес ----------
# Домен стенда. Caddy выпустит на него сертификат Let's Encrypt.
# Для запуска без домена (IP, локальная проверка) поставьте `:80`.
SITE_ADDRESS=docveil.example.ru
# Адрес, который вшивается в бандл фронта и уходит в CORS_ORIGINS.
# Со схемой и без завершающего слэша.
PUBLIC_URL=https://docveil.example.ru
# Почта для Let's Encrypt: на неё придёт письмо об истекающем сертификате.
ACME_EMAIL=ops@example.ru

# ---------- Секреты ----------
POSTGRES_USER=masker
POSTGRES_PASSWORD=
POSTGRES_DB=masker
JWT_SECRET=
MINIO_ROOT_USER=masker
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=documents
# Cookie с refresh-токеном. true — когда стенд за https (обычный случай).
COOKIE_SECURE=true

# ---------- Первый администратор ----------
# Используются один раз, при заведении пользователя; в окружении сервиса
# backend не хранятся — deploy.sh передаёт их разово в `docker compose exec`.
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Администратор

# ---------- Модели ----------
# Провайдер OCR внутри образа: tesseract стоит системным пакетом.
MASKER_OCR=tesseract
# Профиль LLM из backend/masker.yaml: fake — без сети, gigachat — живая модель.
MASKER_LLM=fake
GIGACHAT_CREDENTIALS=
MASKER_LLM_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Путь к сертификату Минцифры ВНУТРИ контейнера. Сам файл положите в
# deploy/gigachat-ca.pem и раскомментируйте монтирование в
# docker-compose.prod.yml.
MASKER_LLM_GIGACHAT_CA_BUNDLE=
OPENROUTER_API_KEY=

# ---------- Базовые образы ----------
# Переопределите, если Docker Hub недоступен или ограничен по частоте: на
# сервере стенда 14.09.2026 `minio/minio` отдавался как «pull access denied»,
# при работающем ghcr.io. MinIO по умолчанию берётся с quay.io — это их
# собственный официальный реестр.
# POSTGRES_IMAGE=postgres:16-alpine
# MINIO_IMAGE=quay.io/minio/minio:latest
# CADDY_IMAGE=caddy:2-alpine

# ---------- Ресурсы ----------
# Один прогон — около 0,55 ГиБ пикового RSS (README, `make bench`).
BACKEND_MEMORY_LIMIT=3g
BACKEND_CPU_LIMIT=4
POSTGRES_MEMORY_LIMIT=1g
MINIO_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=256m
CADDY_MEMORY_LIMIT=256m
