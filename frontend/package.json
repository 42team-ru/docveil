    "@react-router/serve": "^8",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "cross-env": "^10.1.0",
    "docx-preview": "0.4.0",
    "exceljs": "^4.4.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.18.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grab": "^0.2.0",
    "react-is": "^19",
